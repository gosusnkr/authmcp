# ─── TOTP Configuration ───────────────────────────────────────────────────────
# Your Base32 TOTP secret from Microsoft Authenticator setup QR code
# You can have multiple accounts — add more as TOTP_SECRET_2, TOTP_SECRET_3, etc.
TOTP_SECRET_1=YOUR_BASE32_SECRET_HERE
TOTP_LABEL_1=my-account@example.com

# TOTP_SECRET_2=ANOTHER_BASE32_SECRET
# TOTP_LABEL_2=work@company.com

# ─── Microsoft OAuth / Azure AD Configuration ─────────────────────────────────
# Register your app at https://portal.azure.com > App registrations
# For personal accounts use: https://login.microsoftonline.com/consumers
# For work/school use:        https://login.microsoftonline.com/{your-tenant-id}
# For both (recommended):     https://login.microsoftonline.com/common

MICROSOFT_CLIENT_ID=YOUR_APP_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_APP_CLIENT_SECRET
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback

# Space-separated OAuth scopes
# Common scopes: openid profile email offline_access User.Read
MICROSOFT_SCOPES=openid profile email offline_access User.Read
