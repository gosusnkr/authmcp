# ─── TOTP Configuration ───────────────────────────────────────────────────────
# Your Base32 TOTP secret from Google Authenticator or similar
# Export from Google Authenticator → Raivo → get the Base32 secret
# You can have multiple accounts — add more as TOTP_SECRET_2, TOTP_SECRET_3, etc.

TOTP_SECRET_1=YOUR_BASE32_SECRET_HERE
TOTP_LABEL_1=email@example.com

# TOTP_SECRET_2=ANOTHER_BASE32_SECRET
# TOTP_LABEL_2=another@example.com
